<?xml version="1.0" encoding="UTF-8"?>
<robot name="lbr_dual_arm">
    <group name="arm_one">
        <chain base_link="lbr_one_link_0" tip_link="lbr_one_link_ee"/>
    </group>
    <group name="arm_two">
        <chain base_link="lbr_two_link_0" tip_link="lbr_two_link_ee"/>
    </group>
    <group name="both_arms">
        <group name="arm_one"/>
        <group name="arm_two"/>
    </group>

    <group_state name="zero" group="arm_one">
        <joint name="lbr_one_A1" value="0"/>
        <joint name="lbr_one_A2" value="0"/>
        <joint name="lbr_one_A3" value="0"/>
        <joint name="lbr_one_A4" value="0"/>
        <joint name="lbr_one_A5" value="0"/>
        <joint name="lbr_one_A6" value="0"/>
        <joint name="lbr_one_A7" value="0"/>
    </group_state>
    <group_state name="zero" group="arm_two">
        <joint name="lbr_two_A1" value="0"/>
        <joint name="lbr_two_A2" value="0"/>
        <joint name="lbr_two_A3" value="0"/>
        <joint name="lbr_two_A4" value="0"/>
        <joint name="lbr_two_A5" value="0"/>
        <joint name="lbr_two_A6" value="0"/>
        <joint name="lbr_two_A7" value="0"/>
    </group_state>
    <group_state name="zero" group="both_arms">
        <joint name="lbr_one_A1" value="0"/>
